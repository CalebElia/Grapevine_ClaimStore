__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
*.log

# Large cached media and ASR intermediates — pulled from ../video_analysis, never committed.
# Ignore everything under processing/, then re-admit ONLY the a2zero text artifacts. The
# split is not fussiness: the two video directories hold 533MB of audio and ASR output,
# including a 117MB .m4a that exceeds GitHub's hard per-file limit outright, while the
# a2zero side is 38 files and ~2.2MB of markdown, review state and two figure crops. The
# markdown carries hand annotations that exist nowhere else and that a regeneration has
# already destroyed once, which is the whole reason any of processing/ is tracked at all.
processing/*
!processing/a2zero-year1/
!processing/a2zero-year2/
!processing/a2zero-year3/
!processing/a2zero-year4/
!processing/a2zero-year5/
!processing/_review/
*.mp4
*.mp3
*.wav

# Document snapshots for mutable sources (documents.snapshot_path) — content-addressed, bulky
snapshots/

.DS_Store
.obsidian/

# Legistar raw response cache — immutable layer, reproducible by re-fetch
.cache/

# Point-in-time pg_dump of the local database. Generated, and generated files go stale --
# which is the exact failure schema/DRIFT.md documents, so committing one alongside it would
# be the problem wearing the costume of the fix. tests/test_schema_drift.py now enforces the
# invariant the snapshot was written to diagnose: canonical schema == canonical + migrations.
# Regenerate whenever you want to look at the real thing:
#   "$(conda info --base)"/envs/grapevine-db/bin/pg_dump -h /tmp -p 5433 -U grapevine \
#       -d grapevine --schema-only --no-owner --no-privileges -f schema/live-snapshot.sql
schema/live-snapshot.sql

# Sync-client conflict copies. Something syncing this directory (iCloud Desktop, Dropbox)
# restores files as "name 2.ext", and 196 of them -- dated weeks earlier -- reappeared in the
# working tree mid-session. None were tracked, so nothing reached the remote, but pytest
# collects tests/*.py by glob: the suite silently grew from 1280 tests to 2395, half of them
# running stale copies of the code. A green run on the wrong file is worse than a red one.
*\ 2.*
*\ [0-9].*
*\ copy.*
*\ copy\ [0-9].*
