# ============================================================================
# Grapevine claim store — local secrets. Copy to .env and fill in.
#
#   cp .env.example .env
#   chmod 600 .env            # owner-only
#   $EDITOR .env
#   set -a; source .env; set +a
#
# .env is gitignored and must never be committed or pasted into a chat.
# Verify what's visible WITHOUT exposing values:  python3 -m pipeline.config
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# AZURE OPENAI  —  three values from the portal, then two deployment names
#
# Azure's v1 API (Aug 2025+) removed the dated `api-version` parameter and the
# Azure-specific client. You now use the standard OpenAI SDK with base_url
# pointed at your resource, which is why these use the SDK's own variable names.
# ─────────────────────────────────────────────────────────────────────────────

# WHERE: Azure AI Foundry portal → your resource → "Keys and Endpoint"
#        Copy the Endpoint value, then APPEND  openai/v1/
#        e.g.  https://<your-resource>.openai.azure.com/openai/v1/
#        The trailing /openai/v1/ is required — without it you get 404s.
OPENAI_BASE_URL=https:

# WHERE: same "Keys and Endpoint" page → KEY 1 (or KEY 2; they're interchangeable)
#        Paste with no quotes and no trailing space.
OPENAI_API_KEY=

# WHERE: Azure AI Foundry portal → your resource → "Deployments"
#        Use the value in the NAME column, NOT the model ID underneath it.
#        If you deployed gpt-5.6-luna and named it "luna-classify", put
#        luna-classify here. This is the most common Azure misconfiguration.
#
#        Named by PIPELINE ROLE, not by model, so swapping models later is a
#        one-line change here with no code edit.

# S6 — the cheap classifier. High volume, low judgment. Recommended: GPT-5.6 Luna
GRAPEVINE_DEPLOYMENT_CLASSIFY=

# S7 — claim extraction. Judgment-heavy. Recommended: GPT-5.6 Terra
GRAPEVINE_DEPLOYMENT_EXTRACT=

# OPTIONAL — a second extraction deployment used only to benchmark quality
# against the primary one (e.g. GPT-5.6 Sol). Leave blank to skip that test.
GRAPEVINE_DEPLOYMENT_EXTRACT_ALT=


# ─────────────────────────────────────────────────────────────────────────────
# HUGGING FACE  —  only needed to re-run speaker diarization
# ─────────────────────────────────────────────────────────────────────────────

# WHERE: 1. Accept the licence at huggingface.co/pyannote/speaker-diarization-3.1
#           AND at huggingface.co/pyannote/segmentation-3.0
#        2. huggingface.co/settings/tokens → New token → type "Read"
#        Without both licence acceptances the model download 401s.
HF_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# POSTGRES  —  defaults match scripts/db.sh; override only if you moved it
# ─────────────────────────────────────────────────────────────────────────────
GRAPEVINE_DSN=host=/tmp port=5433 user=grapevine dbname=grapevine

# ─────────────────────────────────────────────────────────────────────────────
# BENCHMARK — diarized transcript vendor bake-off (pipeline/bench)
#
#   python -m pipeline.bench.run --list    which keys are present (never prints values)
#   python -m pipeline.bench.run --check   3-second validation call to every vendor
#   python -m pipeline.bench.run --vendors all
#
# A missing key SKIPS that vendor. Nothing fails.
#
# ── KEYS ─────────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
REVAI_ACCESS_TOKEN=

# ── MODELS (optional but RECOMMENDED) ────────────────────────────────────────
# The defaults in adapters.py were written from stale knowledge and these vendors ship
# new flagship models faster than a hardcoded string survives. A wrong name is either a
# 400 or — worse — a silent fall back to an older model, which then loses the bake-off
# for a reason that has nothing to do with the vendor.
#
# Grab the CURRENT best model from each dashboard and set it here. `--check` prints
# which model is actually in force for each vendor before you spend anything.
#
#   Deepgram      console.deepgram.com -> Models. Keyterm prompting needs nova-3+.
#                 (default: nova-3)
#   AssemblyAI    the `speech_model` value in their API docs. (default: universal)
#   Speechmatics  this is an OPERATING POINT, not a model: standard | enhanced.
#                 (default: enhanced)
#   Google        aistudio.google.com -> model list. Pro is slower/better than Flash;
#                 worth testing both. (default: gemini-2.5-flash)
#   ElevenLabs    Scribe model_id. (default: scribe_v1)
#   Rev.ai        transcriber value. (default: machine)
DEEPGRAM_MODEL=
ASSEMBLYAI_MODEL=
SPEECHMATICS_MODEL=
GEMINI_MODEL=
ELEVENLABS_MODEL=
REVAI_MODEL=

# ── REGION (only if your account is NOT on the default host) ─────────────────
# An EU-resident account calling the global host returns 401 with a message that does
# not mention regions, which is a genuinely confusing hour to lose.
#   AssemblyAI EU:   https://api.eu.assemblyai.com
#   Speechmatics EU: https://asr.api.speechmatics.com  (check your portal)
ASSEMBLYAI_BASE_URL=
SPEECHMATICS_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# TEXT PATH  —  document conversion + parse audit (pipeline/convert_document.py,
# parse_audit.py, convert_compare.py)
#
# Four independent conversions of the same PDF, cross-checked against each other.
# None of these are required for pdfplumber-only work — that backend needs nothing
# below. Fill in only the arms you're actually testing.
# ─────────────────────────────────────────────────────────────────────────────

# ── AZURE CONTENT UNDERSTANDING ───────────────────────────────────────────────
# A SEPARATE service from Azure OpenAI above — its own resource, its own endpoint.
# Confirmed present in Foundry under Services -> Content Understanding.
#
# WHERE: Azure AI Foundry portal -> your Content Understanding resource ->
#        "Keys and Endpoint". This is NOT the OPENAI_BASE_URL resource above.
#        e.g.  https://<your-cu-resource>.services.ai.azure.com
CU_ENDPOINT=

# WHERE: same "Keys and Endpoint" page -> KEY 1
CU_API_KEY=

# CONFIRMED in the Foundry playground for the Document Layout Analyzer: it runs
# on 2026-06-01 (Preview) by default, shown directly in the playground UI next
# to "Run analysis". Get the LITERAL query-string value (likely with a
# "-preview" suffix) from the "Code" tab next to "Playground" -- it shows a
# sample request with the exact string in the URL. Do not guess this one; a
# wrong api-version is a 400, not a silent failure, but it still costs a
# round trip to find out.
CU_API_VERSION=

# WHERE: same "Code" tab as above -- the sample request URL is
#        .../analyzers/{analyzerId}:analyze?api-version=... -- copy the
#        {analyzerId} segment, not the display name ("Document Layout
#        Analyzer"). This is the analyzer with enableFigureAnalysis, which is
#        the whole reason CU is in the mix -- figure alt-text carries the text
#        detected INSIDE a chart/infographic.
#
# CONFIRMED: this analyzer needs NO model deployment. The Configure panel's
# chat-completion/mini/embedding model fields (gpt-5.5, gpt-5.2, etc.) are for
# OTHER CU analyzers (Fields extraction and similar) -- ignore them here.
CU_ANALYZER_ID=

# ── AZURE OPENAI — VISION (Tier 3: render-a-page, ask a model what's on it) ──
# Reuses OPENAI_BASE_URL / OPENAI_API_KEY above -- same resource, no new secret,
# just deployment NAMES that happen to accept image input. Confirm in Foundry ->
# Models that each one accepts image content before setting it here; a
# text-only deployment fails on the first vision call, not at startup.
#
# Deploy TWO if the available tiers differ (e.g. a flagship and a smaller/faster
# one) -- Tier 3 is a cross-check, and a single model has no second opinion to
# disagree with. The ASR benchmark measured smaller models beating flagships on
# structured extraction more than once; do not assume the bigger deployment wins.
GRAPEVINE_DEPLOYMENT_VISION=
GRAPEVINE_DEPLOYMENT_VISION_ALT=

# The chat-completions api-version that accepts image content in the request
# body. Distinct from CU_API_VERSION above -- this is Azure OpenAI's versioning,
# not Content Understanding's.
GRAPEVINE_VISION_API_VERSION=

# ── FIRECRAWL ──────────────────────────────────────────────────────────────
# Independent fourth read for Tier 2 cross-converter disagreement. Public
# government PDFs, so no disclosure concern in sending them out.
#   docs: https://docs.firecrawl.dev/features/parse
#         https://docs.firecrawl.dev/features/llm-extract
FIRECRAWL_API_KEY=

# ── OPENAI / AZURE AI FOUNDRY ────────────────────────────────────────────────
# Leave blank unless you deploy a transcription model. The endpoint currently has no
# callable deployments, and gpt-4o-transcribe-diarize needs a different region and a
# separate Foundry project. Skip it with:  --vendors deepgram,assemblyai,...
GRAPEVINE_DEPLOYMENT_TRANSCRIBE=
